theorem duhamel_integral_time_deriv
    (lam : ℝ) (hlam : 0 ≤ lam) (f : ℝ → ℝ) {T : ℝ}
    (hf : ContinuousOn f (Set.Icc 0 T)) {t : ℝ} (ht : t ∈ Set.Ioo (0 : ℝ) T) :
    HasDerivAt (fun s : ℝ => perModeConv lam f s)
      (-lam * perModeConv lam f t + f t) t := sorry

