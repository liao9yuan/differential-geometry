      + (∑ a : Fin n, ∑ b : Fin n, ∑ c : Fin n, ig a b * (g1 a u c * f3 v b c)) := by
  have hflat : (∑ k : Fin n, cg k v * (∑ a : Fin n, ∑ b : Fin n, dig u a b * ((1 / 2 : ℝ) *
      ∑ l : Fin n, ig k l * (f3 a l b + f3 b l a - f3 l a b))))
      = ∑ k : Fin n, ∑ a : Fin n, ∑ b : Fin n, ∑ l : Fin n,
