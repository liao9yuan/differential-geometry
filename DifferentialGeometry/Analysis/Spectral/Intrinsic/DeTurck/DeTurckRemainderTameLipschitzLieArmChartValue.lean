    ((∑ w : Fin n, w1 w * f3 w i j)
      + ((∑ k₁ : Fin n, ∑ p : Fin n, ∑ l₁ : Fin n, ∑ m : Fin n,
            ig k₁ p * (ig l₁ m * (f3 i m p * (∑ q : Fin n, (g1 l₁ j q - g0 l₁ j q) * cg q k₁))))
