  set g₁ : SmoothRiemannianMetric I M := realizedFam (I := I) g₀ T T' hδ hδ' s with hg₁
  set W₀ : SmoothCcTensor g₀ 0 2 :=
    iteratedCovGrad (I := I) g₀ 0 2 0 (symmS (I := I) (M := M) g₀ (T - T')) with hW₀
  set D₀ : Tensor0SSpace 2 I x :=
