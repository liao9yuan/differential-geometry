  have hprod' : ContMDiffOn (I.prod 𝓘(ℝ, ℝ)) (I.prod 𝓘(ℝ, Tensor0SModel 6 ℝ E)) ∞
      (fun pp : M × ℝ => TotalSpace.mk' (Tensor0SModel 6 ℝ E)
