    Finset.sum_congr rfl (fun k₁ _ => Finset.sum_congr rfl (fun l _ =>
      Finset.sum_congr rfl (fun r _ => by rw [hg0s i k₁ r])))
  have hq1 : (∑ k₁ : Fin n, ∑ l : Fin n, ∑ r : Fin n, ig k₁ l * (g0 l i r * f3 j r k₁))
