    refine Finset.sum_congr rfl (fun r _ => Finset.sum_congr rfl (fun t _ => Finset.sum_congr rfl (fun k1 _ => Finset.sum_congr rfl (fun l _ => ?_))))
    rw [hga0s j i r, hga0s l k1 t]
