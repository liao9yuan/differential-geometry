    Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ =>
      Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun p _ =>
        Finset.sum_congr rfl (fun k _ => by ring)))))]
