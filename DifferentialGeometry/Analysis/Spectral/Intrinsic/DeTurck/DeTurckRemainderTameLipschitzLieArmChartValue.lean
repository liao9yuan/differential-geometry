            ((chartModelBasis E) j : TangentSpace I x)
          + g₁.inner x
            (deTurckLieCovDerivA (I := I) g₁ g_bg
              (smoothExtensionTangent (I := I) x ((chartModelBasis E) j : TangentSpace I x))
              (smoothExtensionTangent (I := I) x (smoothOrthoFrame (I := I) g₁ x a x))
