private lemma lieCorr0_D_VF_expand (g₁ gP : SmoothRiemannianMetric I M) (x : M)
    (D : Tensor0SSpace 2 I x) (b : E) :
    Tensor0SSpace.toModel D
        ![((PDE.DeTurck.deTurckVF (I := I) g₁ gP : Π b' : M, TangentSpace I b') x : E), b] =
