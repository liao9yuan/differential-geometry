  have hq2 : (∑ k₁ : Fin n, ∑ l : Fin n, ∑ r : Fin n, ig k₁ l * (g0 l k₁ r * f3 j i r))
      = ∑ a : Fin n, ∑ b : Fin n, ∑ w : Fin n, ig a b * (g0 a b w * f3 j i w) := by
