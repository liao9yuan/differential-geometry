    rw [Finset.sum_congr rfl (fun a _ => Finset.sum_comm)]
    rw [Finset.sum_comm]
    rw [show (∑ p : Fin n, ∑ a : Fin n, ∑ b : Fin n, -((ig a p * g1 u p b) * f3 a v b))
