  rw [show (∑ a : Fin n, ∑ b : Fin n, ∑ l : Fin n, W a b l * (f3 a l b + f3 b l a - f3 l a b))
      = ∑ a : Fin n, ∑ b : Fin n, ∑ l : Fin n,
