  have hr5 : (∑ k₁ : Fin n, ∑ l : Fin n, ∑ r : Fin n, ig k₁ l * (g0 i k₁ r * f3 j l r))
      = ∑ a : Fin n, ∑ b : Fin n, ∑ c : Fin n, ig a b * (g0 a i c * f3 j b c) :=
