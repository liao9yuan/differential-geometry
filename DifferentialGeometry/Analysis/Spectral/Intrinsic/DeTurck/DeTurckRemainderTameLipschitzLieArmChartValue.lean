  have hflat : (∑ k : Fin n, cg k v * (∑ a : Fin n, ∑ b : Fin n, ig a b * ((1 / 2 : ℝ) *
      ∑ l : Fin n, dig u k l * (f3 a l b + f3 b l a - f3 l a b))))
