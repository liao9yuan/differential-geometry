private lemma lieCorr0VBFib_basis_value (x : M) (D : Tensor0SSpace 2 I x)
    (i j : Fin (Module.finrank ℝ E)) :
    Tensor0SSpace.toModel (lieCorr0VBFib (I := I) g₀ g₁ x D)
